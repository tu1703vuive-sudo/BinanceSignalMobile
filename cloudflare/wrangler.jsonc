{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binance-signal-paper",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "PAPER", "class_name": "PaperAccount"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PaperAccount"]}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "ALLOWED_ORIGINS": "https://tu1703vuive-sudo.github.io",
    "VAPID_SUBJECT": "https://tu1703vuive-sudo.github.io/BinanceSignalMobile/"
  },
  "observability": {"enabled": false}
}
