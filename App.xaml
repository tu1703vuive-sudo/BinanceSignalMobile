<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BinanceSignalMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Bg">#0B0E11</Color>
            <Color x:Key="Card">#151A20</Color>
            <Color x:Key="Card2">#1E2630</Color>
            <Color x:Key="Text">#EAECEF</Color>
            <Color x:Key="Muted">#848E9C</Color>
            <Color x:Key="Yellow">#F3BA2F</Color>
            <Color x:Key="Green">#0ECB81</Color>
            <Color x:Key="Red">#F6465D</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Bg}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Card2}" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
