<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BinanceSignalMobile.ViewModels"
             x:Class="BinanceSignalMobile.Views.MainPage"
             Title="Binance Signal">
    <Grid RowDefinitions="Auto,Auto,*" Padding="14,8,14,12" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <VerticalStackLayout Spacing="1">
                <Label Text="BINANCE SIGNAL" FontSize="22" FontAttributes="Bold" />
                <Label Text="{Binding Status}" FontSize="12" TextColor="{StaticResource Green}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="＋" FontSize="22" Clicked="AddCoin_Clicked" WidthRequest="48" HeightRequest="44" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Text="{Binding ModeText}" Clicked="Mode_Clicked" HorizontalOptions="Fill" />
            <Button Grid.Column="1" Text="↻" Clicked="Refresh_Clicked" WidthRequest="52" />
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Refreshing="RefreshView_Refreshing">
            <CollectionView x:Name="CoinList" ItemsSource="{Binding Coins}" SelectionMode="Single" SelectionChanged="CoinList_SelectionChanged">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="Chưa có coin." HorizontalTextAlignment="Center" TextColor="{StaticResource Muted}" />
                        <Button Text="Thêm BTC/USDT" Clicked="AddCoin_Clicked" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoinViewModel">
                        <Border BackgroundColor="{StaticResource Card}" Stroke="#26313C" StrokeThickness="1" Padding="13" Margin="0,0,0,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="44,*,Auto" RowSpacing="7">
                                <Button Grid.RowSpan="2" Text="{Binding FavoriteGlyph}" FontSize="18" BackgroundColor="Transparent" TextColor="{StaticResource Yellow}" Padding="0" Clicked="Favorite_Clicked" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="{Binding PairDisplay}" FontAttributes="Bold" FontSize="17" />
                                    <Label Text="{Binding ChangeDisplay}" TextColor="{Binding ChangeColor}" FontSize="12" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="End">
                                    <Label Text="{Binding PriceDisplay}" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding SignalDisplay}" TextColor="{Binding SignalColor}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                                    <Label Text="{Binding EntryDisplay}" TextColor="{StaticResource Muted}" FontSize="11" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding ScoreDisplay}" TextColor="{StaticResource Muted}" FontSize="11" />
                                </Grid>
                                <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LifecycleMessage}" TextColor="{StaticResource Muted}" FontSize="10" MaxLines="2" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
