<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BinanceSignalMobile.Views.CoinDetailPage"
             Title="Chi tiết">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding PairDisplay}" FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding SignalDisplay}" TextColor="{Binding SignalColor}" FontAttributes="Bold" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="{Binding PriceDisplay}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    <Label Text="{Binding ChangeDisplay}" TextColor="{Binding ChangeColor}" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Text="15m" Clicked="Interval_Clicked" CommandParameter="15m" />
                <Button Grid.Column="1" Text="1H" Clicked="Interval_Clicked" CommandParameter="1h" />
                <Button Grid.Column="2" Text="4H" Clicked="Interval_Clicked" CommandParameter="4h" />
                <Button Grid.Column="3" Text="1D" Clicked="Interval_Clicked" CommandParameter="1d" />
            </Grid>

            <Border BackgroundColor="{StaticResource Card}" Stroke="#26313C" Padding="4">
                <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                <GraphicsView x:Name="Chart" HeightRequest="260" />
            </Border>
            <Label x:Name="ChartStatus" Text="Đang tải biểu đồ…" TextColor="{StaticResource Muted}" FontSize="11" />

            <Border BackgroundColor="{StaticResource Card}" Stroke="#26313C" Padding="14">
                <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="TRADE PLAN" FontAttributes="Bold" TextColor="{StaticResource Yellow}" />
                    <Label Text="{Binding EntryDisplay}" />
                    <Label Text="{Binding StopDisplay}" TextColor="{StaticResource Red}" />
                    <Label Text="{Binding TpDisplay}" TextColor="{StaticResource Green}" />
                    <Label Text="{Binding ScoreDisplay}" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding LifecycleMessage}" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource Card}" Stroke="#26313C" Padding="14">
                <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="7">
                    <Label Text="PHÂN TÍCH" FontAttributes="Bold" />
                    <VerticalStackLayout x:Name="Reasons" Spacing="5" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Mở Binance" Clicked="OpenBinance_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
